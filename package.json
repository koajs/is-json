{
  "name": "@koa/is-json",
  "version": "1.0.0",
  "description": "Check if a koa body should be interpreted as JSON",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsup",
    "test": "node  --require ts-node/register --test",
    "test-ci": "npm run test -- --experimental-test-coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "koa",
    "utils",
    "helpers",
    "json",
    "is-json"
  ],
  "license": "MIT",
  "peerDependencies": {
    "koa": ">= 2"
  },
  "author": {
    "name": "Jonathan Ong",
    "email": "me@jongleberry.com",
    "url": "http://jongleberry.com",
    "twitter": "https://twitter.com/jongleberry"
  },
  "contributors": [
    {
      "name": "Haoxin",
      "email": "haoxinst@gmail.com",
      "url": "https://medium.com/@haoxin",
      "twitter": "https://twitter.com/haoxins"
    },
    {
      "name": "Imed Jaberi",
      "email": "imed_jebari@hotmail.fr",
      "url": "https://github.com/3imed-jaberi",
      "twitter": "https://twitter.com/3imed_jaberi"
    }
  ],
  "devDependencies": {
    "@types/node": "^24.10.0",
    "rimraf": "^6.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koajs/is-json.git"
  },
  "bugs": {
    "url": "https://github.com/koajs/is-json/issues"
  },
  "homepage": "https://github.com/koajs/is-json#readme"
